#!/bin/bash
# After a commit ON main: start the testcell CI in the background (scripts/ci_testcell.sh; skip with WHOLECELL_CI=0).
# Feature-branch commits (agent worktrees, other sessions) never trigger it (decision 2026-11-17).
# Enable once per clone with:  git config core.hooksPath scripts/hooks
[ "$(git symbolic-ref --short -q HEAD)" = "main" ] || exit 0
exec "$(git rev-parse --show-toplevel)/scripts/ci_testcell.sh" --detach
